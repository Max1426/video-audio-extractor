<Window x:Class="VideoAudioExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视频音轨提取软件" Height="720" Width="1080" MinHeight="620" MinWidth="900"
        Icon="Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E7EAF0" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="视频音轨提取软件" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="批量提取完整音轨，转换为高质量 MP3" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EEF2FF" CornerRadius="13" Padding="12,5">
                    <TextBlock Text="本地处理 · 文件不会上传" Foreground="#4338CA" FontSize="13" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,20,24,14" Padding="20" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="把视频拖到窗口任意位置" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="支持 MP4、MOV、MKV、AVI、WebM 等常见格式，也可以点击右侧按钮选择多个文件。" Margin="0,7,20,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button x:Name="AddFilesButton" Grid.Column="1" Content="＋ 选择视频" Style="{StaticResource PrimaryButton}" Click="AddFiles_Click" Margin="0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="24,0,24,14" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="18,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="转换列表" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" Text="0 个文件" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenOutputButton" Content="打开所选文件位置" Click="OpenOutput_Click" IsEnabled="False" />
                        <Button x:Name="RemoveButton" Content="移除所选" Click="RemoveSelected_Click" IsEnabled="False" />
                        <Button x:Name="ClearButton" Content="清空列表" Click="Clear_Click" Margin="0" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="TasksGrid" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                              SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              RowHeaderWidth="0" RowHeight="54" ColumnHeaderHeight="38" SelectionChanged="TasksGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F9FB" />
                                <Setter Property="Foreground" Value="#667085" />
                                <Setter Property="BorderBrush" Value="#E7EAF0" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Padding" Value="12,0" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="12,4" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="文件" Width="*" MinWidth="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding FilePath}">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplayPath}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="90" />
                            <DataGridTemplateColumn Header="进度" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="7" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="♫" FontSize="48" HorizontalAlignment="Center" Foreground="#B7C0CF" />
                        <TextBlock Text="还没有添加视频" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="拖入视频或点击“选择视频”开始" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E7EAF0" BorderThickness="0,1,0,0" Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="保存到" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,10,0" />
                <Grid Grid.Column="1" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputDirectoryTextBox" IsReadOnly="True" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" VerticalContentAlignment="Center" />
                    <Button x:Name="BrowseOutputButton" Grid.Column="1" Content="浏览…" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,18,0">
                    <TextBlock Text="音质" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,8,0" />
                    <ComboBox x:Name="BitrateComboBox" Width="130" Padding="8,7" SelectionChanged="BitrateComboBox_SelectionChanged">
                        <ComboBoxItem Tag="128">节省空间 128</ComboBoxItem>
                        <ComboBoxItem Tag="192" IsSelected="True">标准 192</ComboBoxItem>
                        <ComboBoxItem Tag="320">高音质 320</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="取消转换" Click="Cancel_Click" Visibility="Collapsed" />
                    <Button x:Name="StartButton" Content="开始转换" Style="{StaticResource PrimaryButton}" Click="Start_Click" IsEnabled="False" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
